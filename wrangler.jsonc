{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance-tools",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["0 * * * *"] },
  "routes": [{ "pattern": "finance.example.com", "custom_domain": true }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/scripts/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "finance-tools",
      // Local-only placeholder; production is injected by deploy-preflight.mjs.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "apps/api/migrations",
    },
  ],
  "observability": { "enabled": true },
  "vars": { "APP_ORIGIN": "https://finance.example.com" },
}
