{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance-tools",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "subrequests": 12000 },
  "triggers": { "crons": ["0 * * * *"] },
  "routes": [{ "pattern": "finance.laurenceputra.com", "custom_domain": true }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/scripts/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "finance-tools",
      "database_id": "REPLACE_WITH_PROVISIONED_D1_ID",
      "migrations_dir": "apps/api/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "finance-tools" }],
  "observability": { "enabled": true },
  "vars": { "APP_ORIGIN": "https://finance.laurenceputra.com" },
}
