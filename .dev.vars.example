CLERK_PUBLISHABLE_KEY=REPLACE_WITH_CLERK_DEVELOPMENT_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_WITH_CLERK_DEVELOPMENT_SECRET_KEY
